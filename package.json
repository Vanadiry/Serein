{
    "private": true,
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0",
        "pnpm": ">=12"
    },
    "scripts": {
        "build:clean": "node scripts/clean-dist.js",
        "build:css": "tailwindcss -i assets/tailwind-input.css -o ../web-dist/assets/style.css --minify --cwd web",
        "build:js": "pnpm terser web/assets/app.js -o web-dist/assets/app.min.js -c -m",
        "build:html": "node scripts/minify-html.js",
        "build": "pnpm run build:clean && pnpm run build:css && pnpm run build:js && pnpm run build:html"
    },
    "devDependencies": {
        "@swc/html": "^1.16.22",
        "@tailwindcss/cli": "^4.3.5",
        "@tauri-apps/cli": "^2.12.6",
        "tailwindcss": "^4.3.5",
        "terser": "^5.51.2"
    }
}
