{
	"scripts": {
		"build:css": "pnpm tailwindcss -i web_raw/assets/tailwind-input.css -o web/assets/style.css --minify",
		"build:js": "pnpm terser web_raw/assets/app.js -o web/assets/app.min.js -c -m",
		"build:html": "node scripts/minify-html.js",
		"build": "pnpm run build:css && pnpm run build:js && pnpm run build:html"
	},
	"dependencies": {
		"@tailwindcss/cli": "^4.3.0",
		"html-minifier-terser": "^7.2.0",
		"tailwindcss": "^4.3.0",
		"terser": "^5.48.0"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.2"
	}
}
