{
    "scripts": {
        "build:css": "tailwindcss -i assets/tailwind-input.css -o ../web/assets/style.css --minify --cwd web_raw",
        "build:js": "pnpm terser web_raw/assets/app.js -o web/assets/app.min.js -c -m",
        "build:html": "node scripts/minify-html.js",
        "build": "pnpm run build:css && pnpm run build:js && pnpm run build:html"
    },
    "dependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "html-minifier-terser": "^7.2.0",
        "tailwindcss": "^4.3.3",
        "terser": "^5.51.2"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.11.5"
    }
}
