{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Serein",
  "version": "1.4.0",
  "identifier": "com.vanadiry.serein",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "../build/serein_server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    },
    "copyright": "Copyright © 2026 Vanadiry",
    "longDescription": "软件更新追踪器",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
